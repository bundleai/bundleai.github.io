---
/**
 * The dashboard folded into /portfolio, that page now shows the questionnaire
 * when there is no saved profile and the live plan once there is. This route
 * stays only so older links and any in-flight ?next=/dashboard still land.
 */
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to your portfolio · Bundle.ai</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0; url=/portfolio" />
    <link rel="canonical" href="https://bundleai.github.io/portfolio" />
  </head>
  <body>
    <p>Taking you to <a href="/portfolio">your portfolio</a>…</p>
    <script is:inline>
      window.location.replace('/portfolio');
    </script>
  </body>
</html>
