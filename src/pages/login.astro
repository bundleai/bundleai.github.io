---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
---

<BaseLayout
  title="Log in"
  description="Log in to Bundle to pick up your plan, your guardrails and everything you are tracking across venues."
  ribbon={false}
>
  <section class="section login-section">
    <div class="container">
      <div class="card login-card reveal">
        <div class="login-head">
          <Logo markOnly size={34} />
          <h1>Log in to Bundle</h1>
        </div>

        <form class="login-form" id="login-form" novalidate>
          <div class="field">
            <label for="login-email">Email</label>
            <input
              id="login-email"
              type="email"
              name="email"
              autocomplete="email"
              placeholder="you@example.com"
            />
          </div>
          <div class="field">
            <label for="login-password">Password</label>
            <input
              id="login-password"
              type="password"
              name="password"
              autocomplete="current-password"
              placeholder="Your password"
            />
          </div>
          <button type="button" id="login-btn" class="btn btn-primary login-submit">
            Log in
          </button>
          <div class="login-note" id="login-note" aria-live="polite"></div>
        </form>

        <p class="small muted login-alt">
          No account yet? <a href="/portfolio">Build your portfolio</a> and we'll
          save it as you go.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .login-section {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  .login-card {
    max-width: 26rem;
    margin-inline: auto;
    padding: 2.4rem 2.1rem;
  }

  .login-head {
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    text-align: center;
    margin-bottom: 1.7rem;
  }

  .login-head h1 {
    font-size: 1.45rem;
    margin: 0;
  }

  .login-form {
    display: grid;
    gap: 1rem;
  }

  .login-submit {
    width: 100%;
    margin-top: 0.35rem;
  }

  /* Sand-tinted info box, shown once the note has content */
  .login-note {
    background: var(--sand-tint);
    border: 1px solid rgba(201, 162, 39, 0.3);
    color: var(--sand-ink);
    border-radius: var(--r-s);
    padding: 0.8rem 1rem;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .login-note :global(a) {
    color: var(--sand-ink);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 550;
  }

  .login-note:empty {
    display: none;
  }

  .login-alt {
    margin: 1.5rem 0 0;
    text-align: center;
  }
</style>

<script>
  // Accounts live on this device (see /auth.js), so a log in restores whatever
  // plan, holdings and lesson progress this browser already holds.
  const form = document.getElementById('login-form') as HTMLFormElement | null;
  const btn = document.getElementById('login-btn');
  const note = document.getElementById('login-note');
  const next = new URLSearchParams(location.search).get('next') || '/portfolio';

  const attempt = () => {
    const email = (document.getElementById('login-email') as HTMLInputElement).value.trim();
    const pass = (document.getElementById('login-password') as HTMLInputElement).value;

    if (!email || !/^\S+@\S+\.\S+$/.test(email)) {
      if (note) note.textContent = 'Enter a valid email address.';
      return;
    }
    if (pass.length < 8) {
      if (note) note.textContent = 'Password needs at least 8 characters.';
      return;
    }
    if (note) note.textContent = '';
    // @ts-ignore, global from /auth.js
    window.BundleAuth.signIn(email);
    location.href = next;
  };

  btn?.addEventListener('click', attempt);
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    attempt();
  });
</script>
