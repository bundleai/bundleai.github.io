---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Logo from '../components/Logo.astro';

const palette = [
  { name: 'Background', hex: '#F7F8F4', varName: '--bg', light: true },
  { name: 'Surface', hex: '#FFFFFF', varName: '--surface', light: true },
  { name: 'Primary dark', hex: '#14281E', varName: '--ink' },
  { name: 'Primary green', hex: '#21402E', varName: '--green' },
  { name: 'Primary light', hex: '#EDF2EC', varName: '--tint', light: true },
  { name: 'Neutral cream', hex: '#EFE9DC', varName: '--cream', light: true },
  { name: 'Accent gold', hex: '#C9A227', varName: '--gold' },
  { name: 'Border', hex: '#D9E2DB', varName: '--line', light: true },
];

const chart = [
  { name: 'Chart 1', hex: '#1F7A54' },
  { name: 'Chart 2', hex: '#A8871F' },
  { name: 'Chart 3', hex: '#2A6FB0' },
  { name: 'Chart 4', hex: '#C2643C' },
  { name: 'Chart 5', hex: '#0E9384' },
  { name: 'Chart 6', hex: '#7A5AA6' },
];

// 65% background · 20% white cards · 10% greens · 5% gold
const ratio = [
  { name: 'Background', hex: '#F7F8F4', pct: 65 },
  { name: 'White cards', hex: '#FFFFFF', pct: 20 },
  { name: 'Greens', hex: '#21402E', pct: 10 },
  { name: 'Gold', hex: '#C9A227', pct: 5 },
];
---

<BaseLayout
  title="Brand"
  description="The Bundle.ai identity: the four-pill mark, lockups, palette and type, many small pieces, one disciplined whole."
>
  <PageHero
    eyebrow="Brand"
    title='Many small pieces, <em class="serif-aside">one disciplined whole</em>'
    lead="The Bundle mark is four positions of varied weight on a shared baseline, an allocation on a shared baseline. It sits on a calm, light canvas: deep green for structure, gold for the one thing that matters most on a page."
  />

  <section class="section">
    <div class="container">
      <div class="grid cols-2">
        <div class="card spec-card reveal">
          <p class="spec-label mono">Primary lockup</p>
          <div class="spec-stage">
            <Logo size={44} />
          </div>
        </div>
        <div class="card spec-card reveal" style="--d:.07s">
          <p class="spec-label mono">On ink</p>
          <div class="spec-stage dark">
            <Logo size={44} tone="white" />
          </div>
        </div>
        <div class="card spec-card reveal" style="--d:.14s">
          <p class="spec-label mono">Symbol · app icon · favicon</p>
          <div class="spec-stage row">
            <img src="/brand/mark.svg" alt="Bundle mark" width="56" height="56" />
            <img src="/brand/app-icon.svg" alt="Bundle app icon" width="56" height="56" style="border-radius:14px" />
            <img src="/favicon.svg" alt="Bundle favicon" width="28" height="28" style="border-radius:7px" />
          </div>
        </div>
        <div class="card spec-card reveal" style="--d:.21s">
          <p class="spec-label mono">Monochrome</p>
          <div class="spec-stage row mono-stage">
            <img src="/brand/mark-mono.svg" alt="Monochrome mark" width="56" height="56" class="mono-mark" />
            <span class="mono-note">Single colour for print, embossing and forced-colour modes, <code>/brand/mark-mono.svg</code></span>
          </div>
        </div>
      </div>

      <div class="section-head" style="margin-top:4rem">
        <p class="eyebrow reveal">Colour</p>
        <h2 class="h2 reveal" style="--d:.05s">Light canvas, deep green structure, gold used once</h2>
      </div>
      <div class="swatch-grid reveal">
        {
          palette.map((c) => (
            <div class="swatch">
              <span class="sw-chip" style={`background:${c.hex};${c.light ? 'border:1px solid var(--line-2)' : ''}`} />
              <span class="sw-name">{c.name}</span>
              <span class="sw-hex mono">{c.hex}</span>
            </div>
          ))
        }
      </div>
      <div class="ratio reveal">
        <p class="spec-label mono" style="margin-bottom:0.65rem">Usage ratio</p>
        <div class="ratio-bar">
          {
            ratio.map((r) => (
              <span
                class="ratio-seg"
                style={`flex:${r.pct};background:${r.hex}`}
                title={`${r.name} ${r.pct}%`}
              />
            ))
          }
        </div>
        <ul class="ratio-key">
          {
            ratio.map((r) => (
              <li>
                <span class="key-chip" style={`background:${r.hex}`} />
                {r.name}
                <span class="mono tabular">{r.pct}%</span>
              </li>
            ))
          }
        </ul>
      </div>

      <p class="small muted reveal" style="margin:2.5rem 0 0">
        Data visualisation uses a separate six-hue categorical palette, validated
        for colour-vision-deficiency separation and ≥3:1 contrast on white. Charts never borrow status colours, and status colours never play series. Brand gold sits at 2.42:1 on white, so charts use a darker gold step and the gold CTA carries a dark-green label rather than white.
      </p>
      <div class="swatch-grid chart-grid reveal">
        {
          chart.map((c) => (
            <div class="swatch">
              <span class="sw-chip small" style={`background:${c.hex}`} />
              <span class="sw-hex mono">{c.hex}</span>
            </div>
          ))
        }
      </div>

      <div class="section-head" style="margin-top:4rem">
        <p class="eyebrow reveal">Type</p>
        <h2 class="h2 reveal" style="--d:.05s">Elegant serif headings, humane body, honest numbers</h2>
      </div>
      <div class="grid cols-3">
        <div class="card type-card reveal">
          <p class="spec-label mono">Display, Instrument Serif</p>
          <p class="type-demo display" style="font-size:2.4rem">Discipline by design</p>
        </div>
        <div class="card type-card reveal" style="--d:.07s">
          <p class="spec-label mono">Body, Inter</p>
          <p class="type-demo">Spread small amounts across many startups, with the discipline professional investors rely on.</p>
        </div>
        <div class="card type-card reveal" style="--d:.14s">
          <p class="spec-label mono">Data, IBM Plex Mono</p>
          <p class="type-demo mono">£4,820 · 23 companies<br />largest position 9%</p>
        </div>
      </div>

      <div class="card serif-card reveal" style="margin-top:1.25rem">
        <p class="spec-label mono">Editorial accent, Instrument Serif italic</p>
        <p class="serif-aside" style="font-size:1.6rem; margin:0">
          “One bet is a gamble. Twenty is a strategy.”
        </p>
        <p class="small muted" style="margin:0.75rem 0 0">Used sparingly: pull quotes and single emphasised phrases. Never for UI, never for numbers.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .spec-card {
    padding: 1.5rem;
  }

  .spec-label {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-2);
    margin: 0 0 1rem;
  }

  .spec-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 130px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--r-s);
  }

  .spec-stage.dark {
    background: var(--ink);
    border-color: var(--line-2);
  }

  .spec-stage.row {
    gap: 2rem;
  }

  .mono-stage {
    color: var(--ink);
    padding: 0 1.5rem;
  }

  .mono-note {
    font-size: 0.82rem;
    color: var(--text-2);
    max-width: 22rem;
  }

  .swatch-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 1rem;
  }

  .chart-grid {
    grid-template-columns: repeat(6, 1fr);
    max-width: 40rem;
    margin-top: 1rem;
  }

  .swatch {
    display: grid;
    gap: 0.35rem;
  }

  .sw-chip {
    height: 64px;
    border-radius: var(--r-s);
  }

  .sw-chip.small {
    height: 34px;
  }

  .sw-name {
    font-size: 0.82rem;
    font-weight: 570;
    color: var(--ink);
  }

  .sw-hex {
    font-size: 0.7rem;
    color: var(--text-2);
  }

  .ratio {
    margin-top: 2.5rem;
  }

  .ratio-bar {
    display: flex;
    height: 42px;
    border-radius: var(--r-s);
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .ratio-seg {
    display: block;
  }

  .ratio-key {
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 0.82rem;
    color: var(--text-2);
  }

  .ratio-key li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .key-chip {
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 3px;
    border: 1px solid var(--line-2);
  }

  @media (max-width: 900px) {
    .swatch-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .chart-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .type-card,
  .serif-card {
    padding: 1.5rem;
  }

  .type-demo {
    margin: 0;
    color: var(--ink);
  }
</style>
