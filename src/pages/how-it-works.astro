---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CTABand from '../components/CTABand.astro';
import VizFlow from '../components/VizFlow.astro';

const steps = [
  {
    icon: 'search',
    title: 'Scan',
    body: 'Every venue, continuously. New listings land the minute they go live.',
  },
  {
    icon: 'sliders',
    title: 'Screen',
    body: 'Cut the market by sector, valuation, ticket size, venue or type.',
  },
  {
    icon: 'scale',
    title: 'Compare',
    body: 'One company, several venues: price, fees, minimums and share class, side by side.',
  },
  {
    icon: 'exchange',
    title: 'Execute',
    body: 'One click into the live deal, on the venue that lists it.',
  },
  {
    icon: 'pie',
    title: 'Track',
    body: 'Every position in one P&L, revalued as new rounds price.',
  },
];

const is = [
  'A screener for the whole private market: crowdfunding, secondaries, pre-IPO',
  'A comparison layer: price, fees, minimums and access, venue by venue',
  'One portfolio and alert engine across every venue you use',
];

const isnt = [
  'Not a broker or exchange. Trades execute on the venue that lists the deal',
  'Not a custodian. Bundle never holds your money or your shares',
  'Not an adviser. We show the whole market, we never tell you what to buy',
];
---

<BaseLayout
  title="How it works"
  description="How Bundle works: scan every private-market venue, screen and compare deals, execute on the listing venue, and track it all in one portfolio."
>
  <PageHero
    eyebrow="How it works"
    title="From scattered venues to <em>one order flow.</em>"
    lead="Five steps from a dozen tabs to a routed order, on the venue that lists the deal."
  >
    <a slot="actions" href="/deals" class="btn btn-primary btn-lg">Open the screener <span class="arrow">→</span></a>
    <a slot="actions" href="/portfolio" class="btn btn-ghost btn-lg">Build my portfolio</a>
  </PageHero>

  <!-- The flow -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">The loop</p>
        <h2 class="h2 reveal" style="--d:.05s">Discovery to execution, five steps</h2>
      </div>
      <VizFlow steps={steps} />

      <div class="route-strip panel-tint reveal" style="--d:.1s">
        <span class="rs-node mono">You</span>
        <span class="rs-line" aria-hidden="true"></span>
        <span class="rs-node is-brand mono"><Icon name="layers" size={15} /> Bundle compares</span>
        <span class="rs-line" aria-hidden="true"></span>
        <span class="rs-node mono"><Icon name="shield" size={15} /> Venue executes &amp; holds</span>
        <span class="rs-tag mono">Money never touches Bundle</span>
      </div>
    </div>
  </section>

  <!-- Is / isn't -->
  <section class="section section-ink grain">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">No small-print surprises</p>
        <h2 class="h2 reveal" style="--d:.05s">What Bundle is, and refuses to be</h2>
      </div>
      <div class="grid cols-2">
        <div class="isnt-panel reveal">
          <p class="isnt-head yes mono">Is</p>
          <ul class="isnt-list">
            {
              is.map((t) => (
                <li class="isnt-row">
                  <span class="isnt-mark yes"><Icon name="check" size={13} stroke={2.4} /></span>
                  <span>{t}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="isnt-panel reveal" style="--d:.07s">
          <p class="isnt-head no mono">Is not</p>
          <ul class="isnt-list">
            {
              isnt.map((t) => (
                <li class="isnt-row">
                  <span class="isnt-mark no"><Icon name="close" size={13} stroke={2.4} /></span>
                  <span>{t}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <p class="small muted reveal risk-line">
        Every deal carries the risks of the venue that lists it: illiquidity,
        dilution and the real possibility of losing everything you invest.
        <a href="/legal/risk-warning">Read the risk warning</a>.
      </p>
    </div>
  </section>

  <CTABand
    title="See the whole market <em>before everyone else.</em>"
    sub="The screener is live, and the plan takes three minutes."
    primaryLabel="Build my portfolio"
    primaryHref="/portfolio"
    secondaryLabel="Browse live deals"
    secondaryHref="/deals"
  />
</BaseLayout>

<style>
  /* Where the order actually goes */
  .route-strip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding: 0.9rem 1.1rem;
  }

  .rs-node {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: var(--surface);
    font-size: 0.74rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-2);
    white-space: nowrap;
  }

  .rs-node.is-brand {
    border-color: var(--green);
    background: var(--green);
    color: #fff;
  }

  .rs-line {
    flex: 1;
    min-width: 1.5rem;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--line-2) 0 5px, transparent 5px 10px);
  }

  .rs-tag {
    margin-left: auto;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--green);
  }

  .isnt-panel {
    padding: 1.35rem 1.4rem;
    border: 1px solid var(--line-2);
    border-radius: var(--r-m);
    background: rgba(255, 255, 255, 0.02);
  }

  .isnt-head {
    margin: 0 0 0.9rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .isnt-head.yes { color: var(--gold); }
  .isnt-head.no { color: #b4c4b4; }

  .isnt-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .isnt-row {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    color: #c9d6c9;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .isnt-mark {
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 0.1rem;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .isnt-mark.yes {
    background: rgba(201, 162, 39, 0.18);
    color: var(--gold);
  }

  .isnt-mark.no {
    background: rgba(255, 255, 255, 0.08);
    color: #b4c4b4;
  }

  .risk-line {
    margin-top: 1.5rem;
    max-width: 46rem;
  }
</style>
