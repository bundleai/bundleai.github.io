---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CTABand from '../components/CTABand.astro';
import VizLayers from '../components/VizLayers.astro';
import VizTimeline from '../components/VizTimeline.astro';

const principles = [
  {
    icon: 'scale',
    title: 'Neutral ranking',
    body: 'Results order by your filters. Sponsored placement, if it ever exists, gets labelled unmistakably.',
  },
  {
    icon: 'coins',
    title: 'No markups, no spreads',
    body: "You pay the venue's price and fees. Deals with no referral programme are displayed identically.",
  },
  {
    icon: 'clock',
    title: 'Honest data freshness',
    body: 'Every listing carries a last-checked timestamp and a link to its source.',
  },
  {
    icon: 'eye',
    title: 'Humans oversee the AI',
    body: 'Agents scan and draft; people review anything consequential. Every output is logged.',
  },
  {
    icon: 'doc',
    title: 'Risk on the surface',
    body: 'Warnings sit on the page, not behind a link. Downside before upside.',
  },
  {
    icon: 'ban',
    title: 'No manufactured urgency',
    body: "Real venue deadlines only. No countdown theatre, no “£12k left!” bars, no confetti.",
  },
];

const layers = [
  {
    label: 'Layer 1',
    icon: 'layers',
    title: 'Bundle · the screen',
    body: 'Discovery, comparison, watchlists and tracking. No money, no custody, no advice.',
    items: ['Aggregation', 'Comparison', 'Alerts', 'Portfolio view'],
  },
  {
    label: 'Layer 2',
    icon: 'shield',
    title: 'The venue · where your protection lives',
    body: 'Crowdfunding platforms and secondary marketplaces operate under their own authorisations (FCA in the UK, SEC/FINRA in the US). Your money moves under their rules, not ours, and they run the checks at the point of investment.',
    items: [
      'Regulatory permissions',
      'Nominee & client-money custody',
      'Appropriateness tests',
      'Cooling-off periods',
      'Eligibility checks',
    ],
  },
  {
    label: 'Layer 3',
    icon: 'alert',
    accent: 'warn' as const,
    title: 'The company · what no one can protect you from',
    body: 'Company failure, illiquidity and dilution are inherent to the asset class on every venue. No aggregator changes that.',
    items: ['Total loss possible', 'Years without a sale', 'Dilution by later rounds'],
  },
];

const phases = [
  {
    marker: 'Phase 1',
    title: 'Pure aggregation',
    body: 'Discovery, comparison, watchlists and tracking: activities that need no FCA authorisation, run with financial-promotion rules in mind.',
    status: 'The launch path',
    done: true,
  },
  {
    marker: 'Phase 2',
    title: 'Authorised distribution',
    body: 'Deeper routing and pre-filled orders ship only under FCA permissions, or with an authorised partner firm.',
    status: 'In preparation',
  },
  {
    marker: 'Phase 3',
    title: 'Embedded execution',
    body: 'Venue APIs complete the trade without leaving Bundle, under whatever permissions that requires.',
    status: 'The destination',
  },
];
---

<BaseLayout
  title="Trust & Safety"
  description="How Bundle keeps the tape honest: neutral ranking, no markups, timestamped data, human oversight of AI, and a clear line on where regulatory protection actually comes from."
>
  <PageHero
    eyebrow="Trust & Safety"
    title='An aggregator is only useful if you can <em class="serif-aside">trust the screen.</em>'
    lead="Skyscanner works because nobody suspects the results are rigged. Bundle holds itself to the same bar."
  >
    <Fragment slot="actions">
      <a href="#principles" class="btn btn-primary btn-lg">The house rules <span class="arrow">→</span></a>
      <a href="/legal/risk-warning" class="btn btn-ghost btn-lg">Read the risk warning</a>
    </Fragment>
  </PageHero>

  <!-- House rules -->
  <section class="section" id="principles">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">House rules</p>
        <h2 class="h2 reveal" style="--d:.05s">Six rules the screen never breaks</h2>
      </div>
      <div class="grid cols-3">
        {
          principles.map((p, i) => (
            <article class="card card-hover rule-card reveal" style={`--d:${(i % 3) * 0.07}s`}>
              <span class="rule-num mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="icon-chip"><Icon name={p.icon} /></span>
              <h3 class="h3" style="margin:1rem 0 0.35rem">{p.title}</h3>
              <p class="small muted" style="margin-bottom:0">{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Where protection comes from -->
  <section class="section section-ink grain">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">The honest map</p>
        <h2 class="h2 reveal" style="--d:.05s">Where your protection actually comes from</h2>
        <p class="lead reveal" style="--d:.1s">
          You invest on the listing venue, so the regulatory protections are the
          venue's. Here is the whole stack.
        </p>
      </div>
      <VizLayers layers={layers} tone="dark" />
    </div>
  </section>

  <!-- Regulatory path -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow reveal">Regulatory path</p>
        <h2 class="h2 reveal" style="--d:.05s">Built to grow into regulation, not around it</h2>
      </div>
      <VizTimeline items={phases} />
    </div>
  </section>

  <CTABand
    title="Neutrality is <em>the product.</em>"
    sub="If you ever catch the screen bending, tell us: that's the whole company on the line."
    primaryLabel="Build my portfolio"
    primaryHref="/portfolio"
    secondaryLabel="Contact us"
    secondaryHref="/contact"
  />
</BaseLayout>

<style>
  .rule-card {
    position: relative;
  }

  .rule-num {
    position: absolute;
    top: 1.25rem;
    right: 1.35rem;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--faint);
  }
</style>
