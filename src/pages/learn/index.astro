---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import CTABand from '../../components/CTABand.astro';
import { lessons, lessonMeta } from '../../data/lessons';

const totalMinutes = lessons.reduce((a, l) => a + l.minutes, 0);
---

<BaseLayout
  title="Academy"
  description="Free, plain-English lessons on startup portfolio investing, each one a short interactive explainer you can watch or read: diversification, failure rates, dilution, illiquidity, SEIS/EIS and portfolio craft."
>
  <PageHero
    eyebrow="The Academy"
    title='Learn startup investing <em class="serif-aside">before</em> you risk a pound'
    lead={`Eight short explainers, ${totalMinutes} minutes end to end. Each one plays like a video, pauses where you want to think, and reads as text underneath. Free, honest about the failure rates, no sign-up needed to watch.`}
  >
    <Fragment slot="actions">
      <a href={`/learn/${lessons[0].slug}`} class="btn btn-primary btn-lg" id="lp-start">
        Start lesson one <span class="arrow">→</span>
      </a>
      <a href="/portfolio" class="btn btn-ghost btn-lg">Build my portfolio</a>
    </Fragment>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="path-strip panel-tint reveal">
        <div class="ps-item">
          <span class="mono ps-k">The full path</span>
          <span class="ps-v" id="ps-count">{lessons.length} lessons · ~{totalMinutes} minutes</span>
        </div>
        <div class="ps-progress" id="ps-progress" aria-label="Path progress">
          {lessons.map((l) => <span class="ps-dot" data-slug={l.slug} />)}
        </div>
        <span class="ps-note" id="ps-note">
          Your progress is kept on this device. Sign in and it follows you.
        </span>
      </div>

      <div class="grid cols-4" style="margin-top:2rem">
        {
          lessons.map((l, i) => (
            <a
              href={`/learn/${l.slug}`}
              class="card card-hover lesson-card reveal"
              data-lesson-card={l.slug}
              style={`--d:${(i % 4) * 0.06}s`}
            >
              <div class="lc-top">
                <span class="icon-chip">
                  <Icon name={l.icon} size={19} />
                </span>
                <span class="badge badge-green">{l.category}</span>
              </div>
              <h3 class="lc-name">{l.title}</h3>
              <p class="small muted lc-desc">{l.blurb}</p>
              <span class="lc-foot">
                <span class="lc-meta mono">{lessonMeta(l)}</span>
                <span class="lc-play">
                  <span class="lc-play-i">▶</span> Watch
                </span>
              </span>
              <span class="lc-done" hidden>✓ Complete</span>
            </a>
          ))
        }
      </div>

      <p class="small muted reveal" style="margin-top:1.5rem; max-width:52rem">
        Every lesson is an interactive explainer: scrub it, step through the
        chapters, drag the controls where a scene has one, or skip the player and
        read the text version. Figures are illustrative teaching numbers drawn
        from published ranges, never live data and never a forecast.
      </p>
    </div>
  </section>

  <CTABand
    title="Education is the front door. <em class='serif-aside'>Walk in.</em>"
    sub="Finish a lesson and your progress saves. Build your plan and the same principles become guardrails: an allocation cap, a target spread, and deals ranked against both."
    secondaryLabel="Browse live deals"
    secondaryHref="/deals"
  />
</BaseLayout>

<style>
  .path-strip {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1.4rem 1.75rem;
    flex-wrap: wrap;
  }

  .ps-k {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green-deep);
  }

  .ps-v {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--ink);
    font-size: 1.05rem;
  }

  .ps-progress {
    display: flex;
    gap: 0.45rem;
  }

  .ps-dot {
    width: 26px;
    height: 8px;
    border-radius: 999px;
    background: var(--chart-track);
    transition: background-color 0.2s ease;
  }

  .ps-dot.done {
    background: var(--sage, var(--green));
  }

  .ps-note {
    margin-left: auto;
    font-size: 0.8rem;
    color: var(--text-2);
    max-width: 26rem;
  }

  .lesson-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    position: relative;
  }

  .lc-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .lc-name {
    font-size: 1.05rem;
    margin: 1rem 0 0.35rem;
    font-family: var(--font-display);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .lc-desc {
    margin-bottom: 1rem;
  }

  .lc-foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    border-top: 1px solid var(--line);
    padding-top: 0.8rem;
  }

  .lc-meta {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .lc-play {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.84rem;
    font-weight: 570;
    color: var(--green);
  }

  .lc-play-i {
    display: grid;
    place-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--tint);
    font-size: 0.6rem;
    padding-left: 2px;
    transition: background-color 0.16s ease, color 0.16s ease;
  }

  .lesson-card:hover .lc-play-i {
    background: var(--green);
    color: #fff;
  }

  .lc-done {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: var(--up-tint);
    color: var(--up-ink);
    border-radius: var(--r-pill);
    padding: 0.2rem 0.6rem;
    font-size: 0.7rem;
    font-weight: 570;
  }

  .lesson-card.done .badge {
    visibility: hidden;
  }
</style>

<script>
  // Progress lives in localStorage (see /auth.js) so the path reflects what this
  // browser has actually watched, signed in or not.
  const paint = () => {
    // @ts-ignore, global from /auth.js
    const done: string[] = window.BundleAuth?.lessonsDone?.() || [];
    const cards = document.querySelectorAll<HTMLElement>('[data-lesson-card]');

    cards.forEach((card) => {
      const isDone = done.includes(card.dataset.lessonCard || '');
      card.classList.toggle('done', isDone);
      const tick = card.querySelector<HTMLElement>('.lc-done');
      if (tick) tick.hidden = !isDone;
      const play = card.querySelector<HTMLElement>('.lc-play');
      if (play && isDone) play.innerHTML = '<span class="lc-play-i">▶</span> Watch again';
    });

    document.querySelectorAll<HTMLElement>('.ps-dot').forEach((d) => {
      d.classList.toggle('done', done.includes(d.dataset.slug || ''));
    });

    const count = document.getElementById('ps-count');
    const note = document.getElementById('ps-note');
    const start = document.getElementById('lp-start');
    const all = cards.length;

    if (done.length && count) {
      count.textContent = `${done.length} of ${all} complete`;
    }

    // @ts-ignore
    const signedIn = !!window.BundleAuth?.signedIn?.();
    if (note) {
      note.textContent = done.length
        ? signedIn
          ? 'Progress saved to your account.'
          : 'Progress is kept on this device. Sign in to save it for good.'
        : 'Your progress is kept on this device. Sign in and it follows you.';
    }

    // Point the hero button at the first lesson still outstanding.
    const nextUp = Array.from(cards).find((c) => !done.includes(c.dataset.lessonCard || ''));
    if (start && nextUp && done.length) {
      start.setAttribute('href', nextUp.getAttribute('href') || '/learn');
      start.innerHTML = 'Continue the path <span class="arrow">→</span>';
    }
  };

  paint();
  document.addEventListener('bundle:lessons', paint);
  document.addEventListener('bundle:auth', paint);
</script>
