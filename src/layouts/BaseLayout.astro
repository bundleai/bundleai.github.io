---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PortfolioModal from '../components/PortfolioModal.astro';
import ChatData from '../components/ChatData.astro';

interface Props {
  title: string;
  description: string;
  /** Hide the slim FCA-style ribbon on non-investment utility pages if needed */
  ribbon?: boolean;
}

const { title, description, ribbon = true } = Astro.props;
const fullTitle = title.includes('Bundle') ? title : `${title} · Bundle.ai`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f7f8f4" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Bundle.ai" />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..700;1,400..600&family=Inter:wght@400..700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="pointer-glow" aria-hidden="true"></div>

    {
      ribbon && (
        <div class="risk-ribbon" role="note" aria-label="Risk warning">
          <p>
            <strong>Don't invest unless you're prepared to lose all the money you
            invest.</strong>
            <span class="ribbon-more">
              This is a high-risk investment and you are unlikely to be protected
              if something goes wrong.
            </span>
            <a href="/legal/risk-warning">Take 2 mins to learn more</a>
          </p>
        </div>
      )
    }

    <Nav />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <PortfolioModal />
    <ChatData />

    <script is:inline src="/wizard.js"></script>
    <script is:inline src="/auth.js"></script>
    <script is:inline src="/handoff.js"></script>
    <script is:inline src="/match.js"></script>
    <script is:inline src="/portfolio-view.js"></script>
    <script is:inline src="/trade-confirm.js"></script>
    <script is:inline src="/chat.js"></script>

    <style>
      body {
        display: flex;
        flex-direction: column;
        min-height: 100dvh;
      }

      .risk-ribbon {
        background: var(--ink);
        color: #b4c4b4;
      }

      .risk-ribbon p {
        max-width: calc(var(--container) + 3rem);
        margin: 0 auto;
        padding: 0.52rem 1.5rem;
        font-size: 0.8rem;
        line-height: 1.5;
        text-align: center;
        text-wrap: balance;
      }

      .risk-ribbon strong {
        color: #ffffff;
        font-weight: 600;
      }

      .risk-ribbon a {
        color: var(--gold);
        text-decoration: underline;
        text-underline-offset: 2px;
        margin-left: 0.35rem;
        white-space: nowrap;
      }

      @media (max-width: 720px) {
        .ribbon-more {
          display: none;
        }
      }
    </style>

    <script>
      // Scroll-reveal
      const revealEls = document.querySelectorAll('.reveal');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) {
        revealEls.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            });
          },
          // Huge top margin: content above the viewport (e.g. after an anchor
          // jump) is treated as already seen and revealed immediately.
          { threshold: 0.12, rootMargin: '99999px 0px -6% 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      }

      // Animated counters: <span data-count="20" data-decimals="0">0</span>
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      const animate = (el: HTMLElement) => {
        const target = parseFloat(el.dataset.count || '0');
        const decimals = parseInt(el.dataset.decimals || '0', 10);
        const plain = 'plain' in el.dataset;
        const dur = 1400;
        const start = performance.now();
        const fmt = (v: number) =>
          plain
            ? String(Math.round(v))
            : v.toLocaleString('en-GB', {
                minimumFractionDigits: decimals,
                maximumFractionDigits: decimals,
              });
        const tick = (now: number) => {
          const t = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = fmt(target * eased);
          if (t < 1) requestAnimationFrame(tick);
          else el.textContent = fmt(target);
        };
        if (reduced) el.textContent = fmt(target);
        else requestAnimationFrame(tick);
      };
      const cio = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              animate(e.target as HTMLElement);
              cio.unobserve(e.target);
            }
          });
        },
        { threshold: 0.5 }
      );
      counters.forEach((el) => cio.observe(el));

      // Pointer response: one rAF-throttled listener moves the page glow.
      // Fine pointers only.
      const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (fine && !reduced) {
        const glow = document.querySelector<HTMLElement>('.pointer-glow');
        let px = 0;
        let py = 0;
        let queued = false;

        const paint = () => {
          queued = false;
          glow?.style.setProperty('--px', px + 'px');
          glow?.style.setProperty('--py', py + 'px');
        };

        window.addEventListener(
          'pointermove',
          (e) => {
            px = e.clientX;
            py = e.clientY;
            if (!document.body.classList.contains('pointer-live')) {
              document.body.classList.add('pointer-live');
            }
            if (!queued) {
              queued = true;
              requestAnimationFrame(paint);
            }
          },
          { passive: true }
        );

        document.addEventListener('pointerleave', () =>
          document.body.classList.remove('pointer-live')
        );
      }

      // Deal cards and screener rows are the trade trigger; keyboard needs parity.
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        const t = (e.target as HTMLElement)?.closest?.('[data-trade][role="button"]');
        if (!t) return;
        e.preventDefault();
        (t as HTMLElement).click();
      });

      // "Build my portfolio" opens the wizard in place rather than navigating.
      // Anyone who already has a plan keeps going to /portfolio, because for
      // them that URL is their dashboard, not a form.
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest?.('a[href^="/portfolio"]');
        if (!a) return;
        const href = a.getAttribute('href') || '';
        // ?edit=1 is the deliberate "change my answers" route; leave it alone.
        if (href.indexOf('edit=') > -1) return;
        // @ts-ignore, global from /auth.js
        const Auth = window.BundleAuth;
        if (Auth?.signedIn?.() && Auth.profile?.()) return;
        e.preventDefault();
        document.dispatchEvent(new CustomEvent('bundle:open-portfolio'));
      });

      // Rows and cards carrying [data-company] open the company dashboard.
      // This lives here rather than in DealCard because the screener builds its
      // own table rows and never renders that component, so the handler never
      // shipped to /deals and the rows were inert.
      const openCompany = (el: Element) => {
        const href = el.getAttribute('data-company');
        if (href) location.href = href;
      };

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        // Anything already interactive wins: the Trade button must not navigate.
        if (target.closest('[data-trade], a, button, input, select, label')) return;
        const row = target.closest('[data-company]');
        if (row) openCompany(row);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        const target = e.target as HTMLElement;
        const row = target.closest?.('[data-company]');
        if (!row || target.closest('[data-trade], a, button, input, select')) return;
        e.preventDefault();
        openCompany(row);
      });

      // Generic tabs: [data-tabs] > [role=tablist] buttons + panels by aria-controls
      document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
        const tabs = Array.from(
          root.querySelectorAll<HTMLButtonElement>('[role="tab"]')
        );
        const select = (tab: HTMLButtonElement) => {
          tabs.forEach((t) => {
            const selected = t === tab;
            t.setAttribute('aria-selected', String(selected));
            t.tabIndex = selected ? 0 : -1;
            const panel = document.getElementById(
              t.getAttribute('aria-controls') || ''
            );
            if (panel) panel.hidden = !selected;
          });
        };
        tabs.forEach((tab, i) => {
          tab.addEventListener('click', () => select(tab));
          tab.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
              const dir = e.key === 'ArrowRight' ? 1 : -1;
              const next = tabs[(i + dir + tabs.length) % tabs.length];
              next.focus();
              select(next);
            }
          });
        });
      });
    </script>
  </body>
</html>
