---
/**
 * Aggregated deal card: company, source venue, venue mark or raise totals,
 * and a trade CTA. The card body opens the company dashboard; the CTA opens
 * the deal on the listing venue.
 */
import type { Deal } from '../data/deals';
import { fmtPrice, fmtChange, platformName } from '../data/deals';

interface Props {
  deal: Deal;
  style?: string;
  class?: string;
}

const { deal: d, style, class: className } = Astro.props;
const initials = d.name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2);
const typeLabel =
  d.type === 'crowdfunding' ? 'Crowdfunding' : d.type === 'pre-ipo' ? 'Pre-IPO' : 'Secondary';
---

<div
  id={d.id}
  class:list={['deal-card', 'card', 'card-hover', className]}
  style={style}
  role="link"
  tabindex="0"
  aria-label={`View ${d.name} company dashboard`}
  data-company={`/company/${d.id}`}
  data-deal-id={d.id}
  data-deal-name={d.name}
  data-deal-venue={platformName(d.platform)}
  data-deal-sector={d.sector}
  data-deal-url={d.url}
>
  <header class="dc-head">
    <span class="dc-avatar" style={`--h: var(--${d.hue})`}>{initials}</span>
    <span class="dc-id">
      <span class="dc-name">{d.name} <span class="dc-code mono">{d.code}</span></span>
      <span class="dc-sector">{d.sector} · {typeLabel}</span>
    </span>
    <span class="src-chip">{platformName(d.platform)}</span>
  </header>

  <div class="dc-price-row">
    {
      d.price != null ? (
        <span class="dc-price px">{fmtPrice(d)}<span class="dc-unit"> /share</span></span>
      ) : (
        <span class="dc-price px">{d.raised}<span class="dc-unit"> raised</span></span>
      )
    }
    {
      d.change != null && d.change !== 0 ? (
        <span class:list={['badge', d.change > 0 ? 'badge-up' : 'badge-down', 'px']}>
          {fmtChange(d)}
        </span>
      ) : d.closes ? (
        <span class="badge badge-sand">Closes in {d.closes}</span>
      ) : d.status ? (
        <span class="badge badge-up">{d.status}</span>
      ) : null
    }
  </div>

  <div class="dc-meta px">
    <span>Valuation <strong>{d.valuation}</strong></span>
    {
      d.investors != null ? (
        <span>Investors <strong>{d.investors}</strong></span>
      ) : (
        <span>Min <strong>{d.minTicket}</strong></span>
      )
    }
  </div>

  <footer class="dc-foot">
    <button
      type="button"
      class="dc-cta"
      data-trade
      data-deal-id={d.id}
      data-deal-name={d.name}
      data-deal-venue={platformName(d.platform)}
      data-deal-sector={d.sector}
      data-deal-url={d.url}
      data-deal-currency={d.currency}
      data-deal-price={d.price ?? ''}
    >
      Trade on {platformName(d.platform)} <span class="arrow">↗</span>
    </button>
    {d.investors != null && <span class="dc-min px">from {d.minTicket}</span>}
  </footer>
</div>

<style>
  .deal-card {
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
    padding: 1.15rem 1.2rem 1.05rem;
    color: var(--text);
    cursor: pointer;
  }

  .dc-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
  }

  .dc-avatar {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--h);
    background: color-mix(in srgb, var(--h) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--h) 30%, transparent);
  }

  .dc-id {
    min-width: 0;
    display: grid;
    gap: 0.05rem;
  }

  .dc-name {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dc-code {
    font-size: 0.68rem;
    color: var(--text-2);
    letter-spacing: 0.06em;
    margin-left: 0.15rem;
  }

  .dc-sector {
    font-size: 0.76rem;
    color: var(--text-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dc-head .src-chip {
    margin-left: auto;
  }

  .dc-price-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .dc-price {
    font-size: 1.42rem;
    font-weight: 500;
    color: var(--ink);
  }

  .dc-unit {
    font-size: 0.72rem;
    color: var(--text-2);
    font-weight: 400;
  }

  .dc-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    font-size: 0.78rem;
    color: var(--text-2);
    border-top: 1px dashed var(--line);
    padding-top: 0.7rem;
  }

  .dc-meta strong {
    color: var(--ink);
    font-weight: 500;
  }

  .dc-foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    padding-top: 0.8rem;
  }

  .dc-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 570;
    color: var(--green);
    border: 0;
    background: none;
    padding: 0;
    cursor: pointer;
  }

  .dc-cta:hover { color: var(--green-deep); }

  .dc-cta .arrow {
    transition: transform 0.18s ease;
  }

  .deal-card:hover .dc-cta .arrow {
    transform: translate(2px, -2px);
  }

  .dc-min {
    font-size: 0.74rem;
    color: var(--text-2);
  }
</style>

<script>
  /**
   * Card body opens the company dashboard; the Trade button (data-trade) is
   * handled separately by PortfolioModal and must not also navigate.
   * Guarded so multiple component instances register the listener only once.
   */
  // @ts-ignore
  if (!window.__bundleCompanyNav) {
    // @ts-ignore
    window.__bundleCompanyNav = true;

    const go = (el: Element) => {
      const href = el.getAttribute('data-company');
      if (href) location.href = href;
    };

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('[data-trade], a, button')) return;
      const card = target.closest('[data-company]');
      if (card) go(card);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const target = e.target as HTMLElement;
      const card = target.closest?.('[data-company]');
      if (!card || target.closest('[data-trade], a, button')) return;
      e.preventDefault();
      go(card);
    });
  }
</script>
