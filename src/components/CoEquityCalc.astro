---
/**
 * Equity calculator for PRIMARY raises only.
 *
 * On a primary round your money goes into the company and buys newly issued
 * shares, so what you own is your cheque over the post-money valuation. That
 * arithmetic does not hold on a secondary or pre-IPO block, where you buy
 * existing shares from a holder and nothing enters the company — which is why
 * the company page only renders this for crowdfunding deals.
 *
 * Post-money is seeded from the venue's published valuation cap where there is
 * one, but stays editable: caps are a ceiling, rounds can price below them, and
 * many raises publish no figure at all. Everything is computed live in the
 * browser from the two numbers on screen, so nothing is hidden.
 */
import type { Deal } from '../data/deals';
import { parseValuationBn } from '../data/companies';

interface Props {
  deal: Deal;
}

const { deal: d } = Astro.props;

// Published cap, in whole currency units. 0 when the venue publishes none.
const capAbs = parseValuationBn(d.valuation) * 1e9;
const hasCap = capAbs > 0;
const isCap = /cap/i.test(d.valuation);

/** "£10+" -> 10, "$100" -> 100, "See venue" -> no figure. */
const minTicketNum = (() => {
  const m = /([\d,]+(?:\.\d+)?)/.exec(d.minTicket);
  return m ? parseFloat(m[1].replace(/,/g, '')) : null;
})();

const defaultAmount = minTicketNum ?? 500;
const defaultPost = hasCap ? Math.round(capAbs) : '';
---

<div
  class="eq"
  data-equity-calc
  data-currency={d.currency}
>
  <div class="eq-inputs">
    <div class="field eq-field">
      <label for={`eq-amt-${d.id}`}>You invest</label>
      <div class="eq-input">
        <span class="eq-cur px">{d.currency}</span>
        <input
          type="number"
          id={`eq-amt-${d.id}`}
          data-eq-amount
          value={defaultAmount}
          min="0"
          step="10"
          inputmode="decimal"
          autocomplete="off"
        />
      </div>
      <p class="hint">
        {minTicketNum != null ? `Venue minimum ${d.minTicket}.` : 'The venue sets the minimum.'}
      </p>
    </div>

    <div class="field eq-field">
      <label for={`eq-post-${d.id}`}>Post-money valuation</label>
      <div class="eq-input">
        <span class="eq-cur px">{d.currency}</span>
        <input
          type="number"
          id={`eq-post-${d.id}`}
          data-eq-post
          value={defaultPost}
          min="0"
          step="100000"
          inputmode="decimal"
          autocomplete="off"
          placeholder="Enter the round's post-money"
        />
      </div>
      <p class="hint">
        {
          hasCap
            ? `Seeded from the ${isCap ? 'published cap' : 'published valuation'} of ${d.valuation}. Edit it if the round prices lower.`
            : 'This venue publishes no figure — take it from the round documents.'
        }
      </p>
    </div>
  </div>

  <dl class="eq-out">
    <div class="eq-row">
      <dt>Share of the company</dt>
      <dd class="px eq-strong" data-eq-equity>—</dd>
    </div>
    <div class="eq-row">
      <dt>Per £10,000 of company value</dt>
      <dd class="px" data-eq-per>—</dd>
    </div>
  </dl>

  <div class="eq-exit">
    <div class="eq-exit-head">
      <h4 class="eq-h4">If the company exits at…</h4>
      <div class="eq-presets" role="group" aria-label="Exit multiple presets">
        <button type="button" data-eq-preset="2">2×</button>
        <button type="button" data-eq-preset="5" class="on">5×</button>
        <button type="button" data-eq-preset="10">10×</button>
      </div>
    </div>

    <div class="pv-ctl eq-slider">
      <label for={`eq-mult-${d.id}`} class="pv-ctl-label">
        <span>Exit multiple on today's valuation</span>
        <span class="px" data-eq-mult-label>5×</span>
      </label>
      <input
        type="range"
        id={`eq-mult-${d.id}`}
        data-eq-mult
        min="1"
        max="20"
        step="1"
        value="5"
      />
      <div class="pv-ctl-val">
        <b data-eq-worth>—</b>
        <span class="pv-ctl-scale">
          on a <span class="px" data-eq-exitval>—</span> exit
        </span>
      </div>
    </div>

    <p class="eq-warn small">
      Before dilution. Every later round issues new shares and shrinks the
      percentage above. A multiple is an arbitrary what-if, not a forecast: most
      early-stage companies never reach an exit and total loss is the single
      most likely outcome.
    </p>
  </div>
</div>

<style>
  .eq {
    display: grid;
    gap: 1.1rem;
  }

  .eq-inputs {
    display: grid;
    gap: 0.9rem;
  }

  .eq-field label {
    font-size: 0.85rem;
  }

  .eq-input {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    border: 1px solid var(--line);
    border-radius: var(--r-m);
    background: var(--surface);
    padding-left: 0.9rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .eq-input:focus-within {
    border-color: var(--green);
    box-shadow: 0 0 0 3px rgba(33, 64, 46, 0.12);
  }

  .eq-cur {
    color: var(--text-2);
    font-size: 0.95rem;
  }

  .eq-input input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    padding: 0.65rem 0.9rem 0.65rem 0.35rem;
    font: inherit;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 1rem;
    color: var(--ink);
  }

  .eq-input input:focus { outline: none; }

  .eq-field .hint {
    font-size: 0.76rem;
    color: var(--text-2);
    margin: 0.35rem 0 0;
    line-height: 1.4;
  }

  .eq-out {
    margin: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .eq-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line);
  }

  .eq-row dt {
    font-size: 0.88rem;
    color: var(--text);
  }

  .eq-row dd {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .eq-strong {
    font-size: 1.15rem !important;
    font-weight: 600;
    color: var(--green) !important;
  }

  .eq-exit-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.7rem;
  }

  .eq-h4 {
    margin: 0;
    font-size: 0.95rem;
  }

  .eq-presets {
    display: inline-flex;
    gap: 0.2rem;
    background: var(--tint-soft);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.15rem;
  }

  .eq-presets button {
    border: 0;
    background: none;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-2);
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    cursor: pointer;
  }

  .eq-presets button.on {
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 1px 2px rgba(20, 40, 30, 0.08);
  }

  .eq-slider input[type='range'] {
    width: 100%;
    accent-color: var(--green);
  }

  .pv-ctl-label {
    display: flex;
    justify-content: space-between;
    font-size: 0.82rem;
    color: var(--text-2);
    margin-bottom: 0.3rem;
  }

  .pv-ctl-val {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 0.35rem;
  }

  .pv-ctl-val b {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--ink);
  }

  .pv-ctl-scale {
    font-size: 0.8rem;
    color: var(--text-2);
  }

  .eq-warn {
    margin: 0.9rem 0 0;
    padding: 0.75rem 0.9rem;
    background: var(--gold-soft);
    border: 1px solid rgba(201, 162, 39, 0.3);
    border-radius: var(--r-s);
    color: var(--ink);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  @media (min-width: 30rem) {
    .eq-inputs { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-equity-calc]').forEach((root) => {
    const cur = root.dataset.currency || '';
    const amountEl = root.querySelector<HTMLInputElement>('[data-eq-amount]');
    const postEl = root.querySelector<HTMLInputElement>('[data-eq-post]');
    const equityEl = root.querySelector<HTMLElement>('[data-eq-equity]');
    const perEl = root.querySelector<HTMLElement>('[data-eq-per]');
    const multEl = root.querySelector<HTMLInputElement>('[data-eq-mult]');
    const multLabel = root.querySelector<HTMLElement>('[data-eq-mult-label]');
    const worthEl = root.querySelector<HTMLElement>('[data-eq-worth]');
    const exitEl = root.querySelector<HTMLElement>('[data-eq-exitval]');
    const presets = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-eq-preset]'));
    if (!amountEl || !postEl) return;

    const money = (n: number) => {
      if (!isFinite(n)) return '—';
      if (n >= 1e9) return `${cur}${(n / 1e9).toFixed(2)}bn`;
      if (n >= 1e6) return `${cur}${(n / 1e6).toFixed(2)}m`;
      if (n >= 1e3) return `${cur}${(n / 1e3).toFixed(1)}k`;
      return `${cur}${n.toLocaleString('en-GB', { maximumFractionDigits: 2 })}`;
    };

    /** Small stakes need many decimals before they stop reading as zero. */
    const pct = (p: number) => {
      if (!isFinite(p) || p <= 0) return '—';
      if (p >= 1) return `${p.toFixed(2)}%`;
      if (p >= 0.01) return `${p.toFixed(3)}%`;
      return `${p.toFixed(5)}%`;
    };

    const render = () => {
      const amount = parseFloat(amountEl.value);
      const post = parseFloat(postEl.value);
      const mult = parseFloat(multEl?.value || '5');

      if (multLabel) multLabel.textContent = `${mult}×`;
      presets.forEach((b) => b.classList.toggle('on', b.dataset.eqPreset === String(mult)));

      const valid = isFinite(amount) && amount > 0 && isFinite(post) && post > 0;
      const share = valid ? amount / post : NaN;

      if (equityEl) equityEl.textContent = valid ? pct(share * 100) : '—';
      // How much of the company £10,000 of value corresponds to, i.e. the
      // reciprocal framing people tend to sanity-check against.
      if (perEl) perEl.textContent = valid ? money(share * 10000) : '—';
      if (exitEl) exitEl.textContent = valid ? money(post * mult) : '—';
      if (worthEl) worthEl.textContent = valid ? money(share * post * mult) : '—';
    };

    [amountEl, postEl].forEach((el) => el.addEventListener('input', render));
    multEl?.addEventListener('input', render);
    presets.forEach((b) =>
      b.addEventListener('click', () => {
        if (multEl) multEl.value = b.dataset.eqPreset || '5';
        render();
      })
    );
    render();
  });
</script>
