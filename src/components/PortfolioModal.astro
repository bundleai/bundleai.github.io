---
/**
 * The investor-profile wizard as a modal. Lives in BaseLayout so any page can
 * open it; deal "Trade" buttons do, carrying the deal they came from so the
 * user lands back on it after signing in.
 */
---

<div class="modal" id="portfolio-modal" hidden role="dialog" aria-modal="true" aria-labelledby="pm-title">
  <div class="modal-scrim" data-close></div>
  <div class="modal-panel">
    <header class="modal-head">
      <div>
        <p class="modal-title" id="pm-title">Why a portfolio comes first</p>
        <p class="modal-sub" id="pm-sub">Thirty seconds on why spread beats picking, then a few questions that turn it into your plan.</p>
      </div>
      <button type="button" class="modal-close" data-close aria-label="Close">✕</button>
    </header>
    <div class="wz-scroll">
      <div id="pm-wizard"></div>
    </div>
    <footer class="modal-foot" id="pm-skip" hidden>
      <a class="pm-skip-link" id="pm-skip-link" href="#" target="_blank" rel="noopener">
        Skip this and go straight to <span id="pm-skip-venue">the venue</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
      <span class="pm-skip-note">
        We think a plan first is the better order. It is still your call.
      </span>
    </footer>
  </div>
</div>

<script>
  const modal = document.getElementById('portfolio-modal');
  const host = document.getElementById('pm-wizard');
  const subEl = document.getElementById('pm-sub');
  const titleEl = document.getElementById('pm-title');
  const skipEl = document.getElementById('pm-skip');
  const skipLink = document.getElementById('pm-skip-link') as HTMLAnchorElement | null;
  const skipVenue = document.getElementById('pm-skip-venue');
  let mounted = false;
  let pendingDeal: Record<string, string> | null = null;
  let lastFocus: HTMLElement | null = null;

  // The deal-specific header overwrites these, so keep the originals to put
  // back when the modal is opened straight from a "Build my portfolio" button.
  const baseTitle = titleEl?.textContent ?? '';
  const baseSub = subEl?.textContent ?? '';

  const openModal = (deal: Record<string, string> | null, opener?: HTMLElement | null) => {
    pendingDeal = deal;
    // The opener is passed explicitly where we know it; activeElement is only
    // the fallback, because a programmatic open leaves focus on <body> and
    // closing would then drop the user at the top of the page.
    lastFocus = opener ?? (document.activeElement as HTMLElement);

    if (titleEl && subEl) {
      if (deal) {
        titleEl.textContent = `Before you trade ${deal.name}`;
        subEl.textContent =
          'Why one deal is never a plan, then a few questions so we can check this ' +
          'one fits yours. We hand you to ' + deal.venue + ' to execute.';
      } else {
        titleEl.textContent = baseTitle;
        subEl.textContent = baseSub;
      }
    }

    // The way out. Offered only when there is somewhere to go, i.e. when this
    // was opened from a deal that carries a venue URL.
    if (skipEl && skipLink && skipVenue) {
      const canSkip = !!deal?.url;
      skipEl.hidden = !canSkip;
      if (canSkip) {
        skipLink.href = deal!.url;
        skipVenue.textContent = deal!.venue || 'the venue';
      }
    }

    modal!.hidden = false;
    document.body.style.overflow = 'hidden';

    if (!mounted) {
      // @ts-ignore, global from /wizard.js
      window.BundleWizard.mount(host, {
        compact: true,
        saveLabel: 'Save & continue',
        onSave: (state: unknown) => {
          // @ts-ignore
          window.BundleAuth.saveDraft(state);
          // @ts-ignore
          const signedIn = window.BundleAuth.signedIn();
          let next: string;

          if (signedIn) {
            // @ts-ignore
            window.BundleAuth.saveProfile(state);
            if (pendingDeal) {
              // @ts-ignore
              window.BundleAuth.addHolding({
                id: pendingDeal.id, name: pendingDeal.name, venue: pendingDeal.venue,
                sector: pendingDeal.sector, url: pendingDeal.url, at: Date.now(),
              });
            }
            next = '/portfolio';
          } else {
            const back = pendingDeal
              ? `/deals#${pendingDeal.id}`
              : location.pathname + location.search;
            // @ts-ignore
            next = window.BundleAuth.gateUrl(back);
          }

          // Close the dialog first so the hand-off owns the screen.
          closeModal();
          // @ts-ignore
          window.BundleHandoff.run(next);
        },
      });
      mounted = true;
    }
    (modal!.querySelector('.modal-close') as HTMLElement)?.focus();
  };

  const closeModal = () => {
    modal!.hidden = true;
    document.body.style.overflow = '';
    if (lastFocus && document.contains(lastFocus) && lastFocus !== document.body) {
      lastFocus.focus();
    }
  };

  document.getElementById('pm-skip-link')?.addEventListener('click', () => {
    if (!pendingDeal) return;
    // @ts-ignore, global from /auth.js
    window.BundleAuth?.addHolding?.({ ...pendingDeal, at: Date.now() });
    closeModal();
  });

  modal?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-close]')) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.hidden) closeModal();
  });

  // Any element carrying data-trade routes into a deal. Someone who has
  // already built a plan goes straight to the venue: the questionnaire is
  // only a gate for people who have not answered it yet.
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest('[data-trade]');
    if (!trigger) return;
    e.preventDefault();

    const deal = {
      id: trigger.getAttribute('data-deal-id') || '',
      name: trigger.getAttribute('data-deal-name') || 'this deal',
      venue: trigger.getAttribute('data-deal-venue') || 'the venue',
      sector: trigger.getAttribute('data-deal-sector') || '',
      url: trigger.getAttribute('data-deal-url') || '',
    };

    // @ts-ignore, global from /auth.js
    const Auth = window.BundleAuth;
    if (Auth?.signedIn() && Auth.profile()) {
      Auth.addHolding({ ...deal, at: Date.now() });
      if (deal.url) window.open(deal.url, '_blank', 'noopener');
      return;
    }

    openModal(deal, trigger as HTMLElement);
  });

  document.addEventListener('bundle:open-portfolio', () => openModal(null));
</script>
