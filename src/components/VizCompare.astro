---
/**
 * VizCompare: compact N-way comparison matrix (routes, tiers, venues).
 * Scrolls inside its own container on narrow screens, never overflows the page.
 * One column can be highlighted.
 */
import Icon from './Icon.astro';

interface Col {
  title: string;
  sub?: string;
  icon?: string;
  highlight?: boolean;
}

interface Props {
  cols: Col[];
  rows: { label: string; values: string[] }[];
  rowHead?: string;
  class?: string;
}

const { cols, rows, rowHead = '', class: className } = Astro.props;
---

<div class:list={['vcmp-wrap', 'table-wrap', className]}>
  <table class="table vcmp">
    <thead>
      <tr>
        <th class="vcmp-corner">{rowHead}</th>
        {
          cols.map((c) => (
            <th class:list={['vcmp-col', c.highlight && 'is-hl']}>
              <span class="vcmp-th">
                {c.icon && (
                  <span class="vcmp-ico">
                    <Icon name={c.icon} size={16} />
                  </span>
                )}
                <span>
                  <span class="vcmp-title">{c.title}</span>
                  {c.sub && <span class="vcmp-sub">{c.sub}</span>}
                </span>
              </span>
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <th scope="row" class="vcmp-rowhead">{r.label}</th>
            {r.values.map((v, i) => (
              <td class:list={[cols[i]?.highlight && 'is-hl']}>{v}</td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .vcmp {
    min-width: 40rem;
  }

  .vcmp th,
  .vcmp td {
    vertical-align: top;
  }

  .vcmp-corner {
    width: 11rem;
    background: var(--tint);
  }

  .vcmp-col {
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.9rem;
    padding-block: 1rem;
    white-space: normal;
  }

  .vcmp-th {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .vcmp-ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--green);
    flex: none;
  }

  .vcmp-title {
    display: block;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .vcmp-sub {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    color: var(--text-2);
  }

  .vcmp-rowhead {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
    text-align: left;
    padding: 0.85rem 1.15rem;
    background: var(--tint-soft);
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }

  .vcmp tbody tr:last-child .vcmp-rowhead {
    border-bottom: 0;
  }

  .vcmp th.is-hl,
  .vcmp td.is-hl {
    background: var(--green-soft);
  }

  .vcmp thead th.is-hl {
    box-shadow: inset 0 3px 0 var(--gold);
  }

  .vcmp tbody tr:hover td.is-hl {
    background: var(--green-soft);
  }
</style>
