---
/**
 * Scrolling market tape of aggregated deals. Duplicated list for a seamless
 * CSS loop; pauses on hover; static (scrollable) when reduced motion is set.
 *
 * The tape is the clearest signal that Bundle aggregates, so it must not read
 * as one venue's feed. Two rules keep it honest:
 *  - crowdfunding rows belong on it too. They carry no per-share mark, so they
 *    show amount raised and investor count instead of price and move.
 *  - rows round-robin across venues, otherwise the 24 Forge listings run first
 *    and everything else scrolls past long after anyone has stopped looking.
 */
import { deals, dataAsOf, fmtPrice, fmtChange, platformName, type Deal } from '../data/deals';

const byVenue = new Map<string, Deal[]>();
deals.forEach((d) => {
  const list = byVenue.get(d.platform) ?? [];
  list.push(d);
  byVenue.set(d.platform, list);
});

const queues = [...byVenue.values()];
const tape: Deal[] = [];
for (let round = 0; queues.some((q) => q.length > round); round++) {
  queues.forEach((q) => {
    if (q[round]) tape.push(q[round]);
  });
}

const venueCount = byVenue.size;

// The loop translates by 50% (one full copy of the run), so a fixed duration
// means speed scales with row count: adding venues silently sped the tape up.
// Pin seconds-per-row instead, and the tape reads at the same pace whether it
// carries 20 deals or 200.
const SECONDS_PER_ROW = 4.2;
const scrollSeconds = Math.round(tape.length * SECONDS_PER_ROW);
---

<div class="ticker" role="marquee" aria-label={`Aggregated market tape: ${tape.length} deals across ${venueCount} venues, indicative venue data as of ${dataAsOf}`}>
  <div class="tape" style={`--scroll-secs:${scrollSeconds}s`}>
    {
      [0, 1].map((copy) => (
        <ul class="tape-run" aria-hidden={copy === 1 ? 'true' : undefined}>
          {tape.map((d) => (
            <li>
              <a href={`/company/${d.id}`}>
                <span class="t-code mono">{d.code}</span>
                <span class="t-name">{d.name}</span>
                <span class="t-price px">{d.price != null ? fmtPrice(d) : (d.raised ?? '—')}</span>
                {
                  d.price != null ? (
                    <span class:list={['t-change', 'px', (d.change ?? 0) > 0 ? 'up' : (d.change ?? 0) < 0 ? 'down' : 'flat']}>
                      {fmtChange(d)}
                    </span>
                  ) : (
                    <span class="t-change px flat">
                      {d.closes ? `${d.closes} left` : d.investors != null ? `${d.investors} inv` : 'raising'}
                    </span>
                  )
                }
                <span class="t-src">{platformName(d.platform)}</span>
              </a>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .ticker {
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
    position: relative;
  }

  .ticker::before,
  .ticker::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 60px;
    z-index: 2;
    pointer-events: none;
  }

  .ticker::before {
    left: 0;
    background: linear-gradient(90deg, var(--surface), transparent);
  }

  .ticker::after {
    right: 0;
    background: linear-gradient(-90deg, var(--surface), transparent);
  }

  .tape {
    display: flex;
    width: max-content;
  }

  .tape-run {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
  }

  .tape-run li a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.55rem 1.4rem;
    font-size: 0.82rem;
    white-space: nowrap;
    color: var(--text-2);
    border-right: 1px solid var(--line);
    transition: background-color 0.15s ease;
  }

  .tape-run li a:hover {
    background: var(--tint);
  }

  .t-code {
    font-size: 0.72rem;
    color: var(--text-2);
    letter-spacing: 0.06em;
  }

  .t-name {
    font-weight: 570;
    color: var(--ink);
  }

  .t-price {
    color: var(--text);
  }

  .t-change.flat {
    color: var(--text-2);
  }

  .t-src {
    font-size: 0.7rem;
    color: var(--text-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .tape {
      animation: tape-scroll var(--scroll-secs, 120s) linear infinite;
    }

    .ticker:hover .tape {
      animation-play-state: paused;
    }
  }

  @keyframes tape-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker {
      overflow-x: auto;
    }
  }
</style>
