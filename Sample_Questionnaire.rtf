  .opt .tick\{width:18px;height:18px;border-radius:50%;border:1.5px solid var(--sage-dim);\
    flex:none;margin-top:1px;display:grid;place-items:center;transition:.16s\}\
  .opt.sel\{border-color:var(--gold);background:linear-gradient(180deg,#1c4433,#173829)\}\
  .opt.sel .tick\{border-color:var(--gold);background:var(--gold)\}\
