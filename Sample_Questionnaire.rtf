\
  /* slider */\
  .sliderwrap\{padding:6px 2px 2px\}\
  input[type=range]\{width:100%;-webkit-appearance:none;appearance:none;height:5px;border-radius:99px;\
    background:linear-gradient(90deg,var(--gold) var(--fill,40%),var(--line) var(--fill,40%));outline:none\}\
  input[type=range]::-webkit-slider-thumb\{-webkit-appearance:none;width:22px;height:22px;border-radius:50%;\
    background:radial-gradient(circle at 35% 30%,var(--gold-soft),var(--gold));border:2px solid #0f281e;cursor:pointer;\
    box-shadow:0 4px 12px -3px rgba(201,162,39,.7)\}\
  input[type=range]::-moz-range-thumb\{width:20px;height:20px;border:2px solid #0f281e;border-radius:50%;\
    background:var(--gold);cursor:pointer\}\
  .slval\{display:flex;justify-content:space-between;align-items:baseline;margin-top:12px\}\
  .slval b\{font-family:var(--serif);font-size:30px;font-weight:500;color:var(--gold-soft)\}\
  .slval .note\{font-size:12.5px;color:var(--sage);text-align:right;max-width:60%\}\
  .scale\{display:flex;justify-content:space-between;font-size:11px;color:var(--sage-dim);margin-top:6px\}\
\
  /* risk warning + notices */\
  .notice\{border:1px solid var(--line);border-left:3px solid var(--gold);background:rgba(201,162,39,.06);\
    border-radius:10px;padding:13px 15px;font-size:13px;color:#d6e0d6;margin:16px 0\}\
  .notice b\{color:var(--gold-soft)\}\
  .warn\{border-left-color:#d98a3d;background:rgba(217,138,61,.08)\}\
  .warn b\{color:#eaa96a\}\
\
  /* footer nav */\
  .nav\{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-top:26px\}\
  .btn\{font-family:var(--sans);font-size:14.5px;font-weight:600;border-radius:11px;padding:12px 24px;\
    cursor:pointer;border:1px solid transparent;transition:.16s\}\
  .btn.next\{background:linear-gradient(180deg,var(--gold-soft),var(--gold));color:#1e1608;\
    box-shadow:0 12px 26px -12px rgba(201,162,39,.75)\}\
  .btn.next:hover\{filter:brightness(1.05)\}\
  .btn.next:disabled\{opacity:.4;cursor:not-allowed;box-shadow:none;filter:none\}\
  .btn.back\{background:transparent;border-color:var(--line);color:var(--sage)\}\
  .btn.back:hover\{border-color:#2f6349;color:var(--cream)\}\
  .btn.ghost\{background:transparent;color:var(--sage-dim);border:none;font-weight:500;padding:12px 4px\}\
\
  .disclaim\{font-size:11px;color:var(--sage-dim);margin-top:20px;text-align:center;line-height:1.5\}\
  a\{color:var(--gold-soft)\}\
\
  /* results */\
  .rgrid\{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin:18px 0\}\
  @media(max-width:520px)\{.rgrid\{grid-template-columns:1fr\}\}\
  .rcell\{border:1px solid var(--line);border-radius:12px;padding:13px 15px;background:var(--forest-hi)\}\
  .rcell .k\{font-size:11px;letter-spacing:.7px;text-transform:uppercase;color:var(--sage-dim);margin-bottom:5px\}\
  .rcell .v\{font-family:var(--serif);font-size:17px;color:var(--cream);line-height:1.25\}\
  .rcell.wide\{grid-column:1 / -1\}\
  .taglist\{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px\}\
  .taglist span\{font-family:var(--sans);font-size:12px;background:rgba(201,162,39,.14);color:var(--gold-soft);\
    border:1px solid rgba(201,162,39,.3);border-radius:99px;padding:3px 10px\}\
  .fade\{animation:fade .32s ease\}\
  @keyframes fade\{from\{opacity:0;transform:translateY(6px)\}to\{opacity:1;transform:none\}\}\
  @media(prefers-reduced-motion:reduce)\{.fade\{animation:none\}*\{transition:none!important\}\}\
</style>\
