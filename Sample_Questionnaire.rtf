  .opt .body b\{display:block;font-weight:600;margin-bottom:2px\}\
  .opt .body small\{color:var(--sage);font-weight:400;font-size:12.5px;line-height:1.4\}\
  .opt.sel .body small\{color:#bcd3c4\}\
